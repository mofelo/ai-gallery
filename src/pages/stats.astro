---
import Layout from '../layouts/Layout.astro';
import { fetchStats } from '../lib/api';

const { data: stats } = await fetchStats();
---

<Layout title="统计 — AI Gallery">
  <div class="min-h-screen bg-neutral-950 text-neutral-100">
    <header class="border-b border-neutral-800">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center gap-6">
        <a href="/" class="text-sm text-neutral-400 hover:text-white transition">← 画廊</a>
        <h1 class="text-xl font-bold">📊 统计</h1>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
      {!stats ? (
        <div class="text-center py-20 text-neutral-500">加载中...</div>
      ) : (
        <div class="grid md:grid-cols-2 gap-8">
          <!-- 模型使用频率 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">🎯 模型使用频率</h2>
            {stats.top_models.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="space-y-3">
                {stats.top_models.slice(0, 10).map(([model, count]) => {
                  const max = stats.top_models[0][1];
                  const pct = Math.round((count / max) * 100);
                  return (
                    <div>
                      <div class="flex justify-between text-sm mb-1">
                        <span class="font-mono truncate">{model}</span>
                        <span class="text-neutral-500">{count}</span>
                      </div>
                      <div class="h-2 bg-neutral-800 rounded-full overflow-hidden">
                        <div class="h-full bg-sky-500 rounded-full" style={`width:${pct}%`}></div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </section>

          <!-- 标签分布 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">🏷️ 标签分布</h2>
            {stats.top_tags.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="flex flex-wrap gap-2">
                {stats.top_tags.map(([tag, count]) => (
                  <span class="bg-neutral-800 text-neutral-300 text-xs px-3 py-1.5 rounded-full">
                    {tag} <span class="text-neutral-500">×{count}</span>
                  </span>
                ))}
              </div>
            )}
          </section>

          <!-- Prompt 关键词 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">💬 Prompt 关键词频率</h2>
            {stats.top_prompt_tokens.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="flex flex-wrap gap-2">
                {stats.top_prompt_tokens.map(([token, count]) => {
                  const max = stats.top_prompt_tokens[0][1];
                  const size = Math.max(0.75, Math.min(1.5, 0.75 + (count / max) * 0.75));
                  return (
                    <span
                      class="font-mono text-sky-300"
                      style={`font-size:${size}rem`}
                      title={`${count} 次`}
                    >{token}</span>
                  );
                })}
              </div>
            )}
          </section>

          <!-- 月度趋势 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">📅 每月新增</h2>
            {stats.by_month.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="flex items-end gap-2 h-40">
                {stats.by_month.map(([month, count]) => {
                  const max = Math.max(...stats.by_month.map(([, c]) => c));
                  const h = Math.round((count / max) * 100);
                  return (
                    <div class="flex-1 flex flex-col items-center gap-1">
                      <span class="text-xs text-neutral-500">{count}</span>
                      <div class="w-full bg-sky-600 rounded-t" style={`height:${h}%`}></div>
                      <span class="text-[10px] text-neutral-600">{month.slice(2)}</span>
                    </div>
                  );
                })}
              </div>
            )}
          </section>

          <!-- 采样器 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">⚙️ 采样器分布</h2>
            {stats.top_samplers?.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="space-y-3">
                {stats.top_samplers?.slice(0, 8).map(([sampler, count]) => (
                  <div class="flex justify-between text-sm">
                    <span class="font-mono">{sampler}</span>
                    <span class="text-neutral-500">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <!-- Seed 分布 -->
          <section class="bg-neutral-900 rounded-2xl border border-neutral-800 p-6">
            <h2 class="font-bold mb-4">🎲 Seed 分布</h2>
            {stats.seed_distribution.length === 0 ? (
              <p class="text-sm text-neutral-500">暂无数据</p>
            ) : (
              <div class="space-y-2">
                {stats.seed_distribution.map(([range, count]) => (
                  <div class="flex justify-between text-xs font-mono">
                    <span class="text-neutral-400">{range}</span>
                    <span class="text-neutral-500">{count}</span>
                  </div>
                ))}
              </div>
            )}
          </section>
        </div>
      )}
    </main>
  </div>
</Layout>