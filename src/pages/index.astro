---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { fetchImages, fetchStats } from '../lib/api';

const { data: images, error: imagesError } = await fetchImages(0, 50);
const { data: stats } = await fetchStats();

const statCards = [
  { label: '图片总数', value: stats?.total_images ?? 0, icon: 'image', color: 'text-info' },
  { label: '使用模型', value: stats?.top_models?.length ?? 0, icon: 'model', color: 'text-accent-soft' },
  { label: '标签数', value: stats?.top_tags?.length ?? 0, icon: 'tag', color: 'text-warning' },
  { label: 'Prompt 关键词', value: stats?.top_prompt_tokens?.length ?? 0, icon: 'search', color: 'text-success' },
];
---

<Layout title="AI Gallery — 图片管理站">
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-10">
    <h1 class="display">AI 画廊</h1>
    <p class="body-lg mt-4 max-w-xl">管理、归纳、总结、推演你的 AI 生成作品。</p>
  </section>

  <!-- 统计摘要 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      {statCards.map((c) => (
        <div class="card card-hover p-6">
          <Icon name={c.icon} size={24} class={c.color} />
          <div class="text-3xl font-heading font-bold mt-4 tracking-tight">{c.value}</div>
          <div class="caption mt-1.5">{c.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 图片画廊 -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 pb-20">
    {imagesError ? (
      <div class="card border-danger/30 p-8 flex items-start gap-4">
        <Icon name="error" size={28} class="text-danger shrink-0 mt-0.5" />
        <div>
          <h2 class="title-lg mb-2">加载失败</h2>
          <p class="body text-fg-muted">{imagesError}</p>
          <p class="caption mt-3">提示: 确保 Worker 已部署且 D1 数据库已有数据</p>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
        {images?.items.map((img) => (
          <a
            href={`/image/${img.number}`}
            class="card card-hover overflow-hidden group"
            aria-label={img.title}
          >
            <div class="aspect-square overflow-hidden bg-surface-2">
              <img
                src={img.png_url}
                alt={img.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300 ease-out"
                onerror="this.src='/placeholder.svg'"
              />
            </div>
            <div class="p-3.5">
              <h3 class="title-md truncate">{img.title}</h3>
              <div class="flex items-center gap-2 mt-1.5 caption">
                <span class="truncate">{img.model || '未知模型'}</span>
                <span class="text-fg-dim">·</span>
                <span class="mono">seed:{img.seed}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    {images?.items.length === 0 && !imagesError && (
      <div class="text-center py-24">
        <Icon name="empty" size={56} class="text-fg-dim mx-auto" />
        <h2 class="title-lg mt-6 mb-2">还没有图片数据</h2>
        <p class="body text-fg-muted">使用 issue-cli 上传第一张图片</p>
        <code class="inline-block mt-4 px-3 py-1.5 rounded-lg bg-surface-2 border hairline mono text-sm text-accent-soft">
          ai-gallery-cli upload &lt;file&gt;
        </code>
      </div>
    )}
  </main>
</Layout>