---
import Layout from '../layouts/Layout.astro';
import { fetchImages, fetchStats } from '../lib/api';

const { data: images, error: imagesError } = await fetchImages(0, 50);
const { data: stats } = await fetchStats();
---

<Layout title="AI Gallery — 图片管理站">
  <div class="min-h-screen bg-neutral-950 text-neutral-100">
    <!-- 顶部导航 -->
    <header class="border-b border-neutral-800 bg-neutral-900/80 backdrop-blur sticky top-0 z-10">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🎨</span>
          <h1 class="text-xl font-bold">AI Gallery</h1>
        </div>
        <nav class="flex gap-6 text-sm text-neutral-400">
          <a href="/" class="hover:text-white transition">画廊</a>
          <a href="/stats" class="hover:text-white transition">统计</a>
          <a href="/cluster" class="hover:text-white transition">聚类</a>
          <a href="/search" class="hover:text-white transition">搜索</a>
        </nav>
      </div>
    </header>

    <!-- 统计摘要 -->
    <section class="max-w-7xl mx-auto px-4 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-neutral-900 rounded-xl p-4 border border-neutral-800">
          <div class="text-3xl font-bold text-emerald-400">{stats?.total_images ?? 0}</div>
          <div class="text-sm text-neutral-400 mt-1">图片总数</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-4 border border-neutral-800">
          <div class="text-3xl font-bold text-sky-400">{stats?.top_models?.length ?? 0}</div>
          <div class="text-sm text-neutral-400 mt-1">使用模型</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-4 border border-neutral-800">
          <div class="text-3xl font-bold text-amber-400">{stats?.top_tags?.length ?? 0}</div>
          <div class="text-sm text-neutral-400 mt-1">标签数</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-4 border border-neutral-800">
          <div class="text-3xl font-bold text-fuchsia-400">{stats?.top_prompt_tokens?.length ?? 0}</div>
          <div class="text-sm text-neutral-400 mt-1">Prompt 关键词</div>
        </div>
      </div>
    </section>

    <!-- 图片画廊 -->
    <main class="max-w-7xl mx-auto px-4 pb-16">
      {imagesError ? (
        <div class="bg-red-950/50 border border-red-900 rounded-xl p-6 text-red-300">
          <h2 class="font-bold mb-2">加载失败</h2>
          <p class="text-sm">{imagesError}</p>
          <p class="text-sm mt-2 text-red-400">提示: 确保 ai-images 仓库有数据，且 Worker 已配置 GITHUB_TOKEN</p>
        </div>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
          {images?.items.map((img) => (
            <a
              href={`/image/${img.number}`}
              class="group bg-neutral-900 rounded-xl overflow-hidden border border-neutral-800 hover:border-neutral-600 transition"
            >
              <img
                src={img.png_url}
                alt={img.title}
                loading="lazy"
                class="w-full aspect-square object-cover group-hover:scale-105 transition duration-300"
                onerror="this.src='/placeholder.svg'"
              />
              <div class="p-3">
                <h3 class="text-sm font-medium truncate">{img.title}</h3>
                <div class="flex items-center gap-2 mt-1 text-xs text-neutral-500">
                  <span class="truncate">{img.model || '未知模型'}</span>
                  <span class="text-neutral-600">·</span>
                  <span>seed:{img.seed}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

      {images?.items.length === 0 && !imagesError && (
        <div class="text-center py-20 text-neutral-500">
          <div class="text-5xl mb-4">🖼️</div>
          <p>还没有图片数据</p>
          <p class="text-sm mt-2">使用 issue-cli 上传第一张图片: <code class="bg-neutral-900 px-2 py-1 rounded">ai-gallery-cli upload &lt;file&gt;</code></p>
        </div>
      )}
    </main>
  </div>
</Layout>