{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "ai-gallery",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "ai_gallery",
			"database_name": "ai-gallery",
			"database_id": "bb376194-1ef6-4d28-9da9-eba688ffc2be",
			"remote": true
		}
	]
}